# Python / venv
.venv/
__pycache__/
*.pyc

# Runtime artifacts — per-user state, never committed
logs/
state.json
history.db
scratchpad.db
scratchpad.txt
dictionary.yaml
learned.yaml
.svara_ready
.scratchpad_migrated
*.wav
# …except the benchmark corpus, which IS the shared reference set.
!bench/corpus/*.wav

# Build output (large — do not commit; built via build.bat)
dist/
build/
*.egg-info/

# OS / editor
Thumbs.db
.DS_Store

# GitHub Pages is built from web/ by the deploy workflow, not committed
docs/

# Release artifacts (uploaded to GitHub Releases, not committed)
*.zip
