# Python / venv
.venv/
__pycache__/
*.pyc

# Runtime artifacts — per-user state, never committed
logs/
state.json
history.db
scratchpad.db
scratchpad.txt
dictionary.yaml
learned.yaml
.svara_ready
.scratchpad_migrated
*.wav
# …except the benchmark corpus, which IS the shared reference set.
!bench/corpus/*.wav

# Build output (large — do not commit; built via build.bat)
dist/
build/
*.egg-info/

# OS / editor
Thumbs.db
.DS_Store

# GitHub Pages is built from web/ by the deploy workflow, not committed
docs/

# Release artifacts (uploaded to GitHub Releases, not committed)
*.zip

# CUDA runtime, downloaded on demand by cuda_setup.download_cuda() into the
# app's own directory. 1.3 GB of NVIDIA redistributables that are fetched from
# the release asset when a user opts into GPU — never source, never committed.
/cuda/
